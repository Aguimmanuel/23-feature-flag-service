# Copy to .env and replace placeholders privately. Never commit .env.
# URL-encode special characters in the local database password.
DATABASE_URL=postgresql+psycopg://feature_flags_app:URL_ENCODED_LOCAL_PASSWORD@127.0.0.1:5432/feature_flags_dev
TEST_DATABASE_URL=postgresql+psycopg://feature_flags_app:URL_ENCODED_LOCAL_PASSWORD@127.0.0.1:5432/feature_flags_test
ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_SECRET
EVALUATION_API_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
APP_ENV=development
